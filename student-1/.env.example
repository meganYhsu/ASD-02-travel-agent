# Student 1 - Traveler Preferences
# Copy to .env for local runs. Docker Compose sets these itself.

# Database microservice
PORT=6001
DATABASE_PATH=preferences.db

# Backend/API microservice
DB_API_URL=http://127.0.0.1:6001
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:0.5b
MCP_BASE_URL=http://127.0.0.1:7004
RAG_BASE_URL=http://127.0.0.1:7001
MULTI_AGENT_SERVICE_URL=http://127.0.0.1:6767
MULTI_AGENT_TIMEOUT_SECONDS=420

# AI services are off unless set to true (CI and the cloud baseline leave
# them unset). Turn them on for a local run with the shared servers started.
AI_MODE_ENABLED=true
MCP_ENABLED=true
RAG_ENABLED=true
MULTI_AGENT_ENABLED=true

# Frontend microservice
BACKEND_URL=http://127.0.0.1:5001
SHARED_HOME_URL=http://127.0.0.1:8080
PROXY_TIMEOUT_SECONDS=450

# Direct runs only (containers use gunicorn): FLASK_HOST=0.0.0.0, FLASK_DEBUG=true
