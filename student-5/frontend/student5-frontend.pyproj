<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>a9f2b6c4-18de-4c55-b0aa-9e4f31c9f003</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>app.py</StartupFile>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>student5-frontend</Name>
    <RootNamespace>student5frontend</RootNamespace>
    <LaunchUrl>http://localhost:8505</LaunchUrl>
    <EnableNativeCodeDebugging>False</EnableNativeCodeDebugging>
    <Environment>PORT=8505
BACKEND_URL=http://127.0.0.1:5505</Environment>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="app.py" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="templates\dashboard.html" />
    <Content Include="static\styles.css" />
    <Content Include="requirements.txt" />
    <Content Include="Dockerfile" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
</Project>
