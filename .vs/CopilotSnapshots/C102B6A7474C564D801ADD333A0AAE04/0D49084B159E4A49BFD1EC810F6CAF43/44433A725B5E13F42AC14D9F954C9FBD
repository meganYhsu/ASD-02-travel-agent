def test_detects_document_expired_before_departure(client):
    created = client.post(
        "/api/documents",
        json={
            "traveller_id": "traveller-before",
            "document_type": "Passport",
            "document_number": "PBEF0001",
            "issuing_country": "Australia",
            "nationality": "Australian",
            "issue_date": "2020-01-01",
            "expiry_date": "2026-08-01",
        },
    )
    assert created.status_code == 201
    response = client.post(
        "/api/ai/check-compliance",
        json={
            "trip_id": "trip-before",
            "traveller_id": "traveller-before",
            "destination": "Japan",
            "nationality": "Australian",
            "departure_date": "2026-09-01",
            "return_date": "2026-09-10",
        },
    )
    data = response.get_json()["data"]
    assert data["expired_documents"]
    assert data["compliant"] is False


def test_detects_expired_and_missing_documents(client):
    response = client.post(
        "/api/alerts/compliance",
        json={
            "trip_id": "trip-002",
            "traveller_id": "traveller-002",
            "destination": "United States",
            "nationality": "British",
            "departure_date": "2026-07-04",
            "return_date": "2026-07-18",
        },
    )
    assert response.status_code == 200
    alerts = response.get_json()["data"]
    types = {item["alert_type"] for item in alerts}
    assert "DOCUMENT_EXPIRED" in types


