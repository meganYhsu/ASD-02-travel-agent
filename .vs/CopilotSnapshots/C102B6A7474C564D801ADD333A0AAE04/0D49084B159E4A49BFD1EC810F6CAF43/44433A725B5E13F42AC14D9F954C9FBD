def test_compliant_traveller(client):
    response = client.post(
        "/api/ai/check-compliance",
        json={
            "trip_id": "trip-001",
            "traveller_id": "traveller-001",
            "destination": "Japan",
            "nationality": "Australian",
            "departure_date": "2026-09-01",
            "return_date": "2026-09-10",
        },
    )
    assert response.status_code == 200
    data = response.get_json()["data"]
    assert data["compliant"] is True
    assert data["missing_documents"] == []
    assert data["expired_documents"] == []


def test_unknown_requirements_are_safe(client):
    response = client.post(
        "/api/ai/check-compliance",
        json={
            "trip_id": "trip-unknown",
            "traveller_id": "traveller-001",
            "destination": "Atlantis",
            "nationality": "Martian",
            "departure_date": "2026-09-01",
            "return_date": "2026-09-10",
        },
    )
    assert response.status_code == 200
    data = response.get_json()["data"]
    assert "No matching entry-requirement records" in " ".join(data["warnings"])
