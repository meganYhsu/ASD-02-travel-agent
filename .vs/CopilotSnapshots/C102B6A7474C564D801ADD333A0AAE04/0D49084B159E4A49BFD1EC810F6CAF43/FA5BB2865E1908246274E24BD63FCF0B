    def load_compliance_context(payload: dict[str, Any]) -> tuple[list[dict[str, Any]], list[dict[str, Any]], dict[str, Any]]:
        documents = db().list("documents", {"traveller_id": payload["traveller_id"]})
        requirements = db().list(
            "entry-requirements",
            {
                "destination_country": payload["destination"],
                "traveller_nationality": payload["nationality"],
            },
        )
        result = evaluate_compliance(
            documents,
            requirements,
            payload.get("departure_date") or payload.get("start_date"),
            payload.get("return_date") or payload.get("end_date"),
        )
        result["disclaimer"] = (
            "Release 0 entry requirements are demonstration data only. "
            "Verify official government sources before real travel."
        )
        return documents, requirements, result

