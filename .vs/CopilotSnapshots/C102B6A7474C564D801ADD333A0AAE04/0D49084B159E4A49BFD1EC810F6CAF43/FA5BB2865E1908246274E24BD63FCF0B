    @app.post("/api/ai/check-compliance")
    def check_compliance():
        try:
            payload = validate_compliance_request(require_object(request.get_json(silent=True)))
            documents, requirements, deterministic = load_compliance_context(payload)
            prompt = (
                "You are a travel-document compliance assistant.\n"
                "Only assess the supplied entry requirement records. "
                "Do not introduce immigration requirements that are not present in the provided data.\n"
                "Return JSON with keys: summary, warnings, recommended_actions, reasoning.\n"
                "Do not invent documents or requirements.\n"
                f"Context: {json.dumps({'request': payload, 'documents': documents, 'entry_requirements': requirements, 'deterministic': deterministic})}"
            )
            ai_data = ollama().generate_json(prompt)
            merged = dict(deterministic)
            if isinstance(ai_data.get("summary"), str) and ai_data["summary"].strip():
                merged["summary"] = ai_data["summary"].strip()
            if isinstance(ai_data.get("reasoning"), str):
                merged["reasoning"] = ai_data["reasoning"].strip()
            if isinstance(ai_data.get("warnings"), list):
                merged["warnings"] = list(dict.fromkeys(merged["warnings"] + [str(item) for item in ai_data["warnings"]]))
            if isinstance(ai_data.get("recommended_actions"), list):
                merged["recommended_actions"] = list(
                    dict.fromkeys(merged["recommended_actions"] + [str(item) for item in ai_data["recommended_actions"]])
                )
            merged["phase"] = "PLAN"
            return json_ok(merged)
        except ValidationError as exc:
            return json_error(exc.message, exc.status)
        except OllamaError as exc:
            return json_error(exc.message, exc.status)
        except DatabaseUnavailable:
            return json_error("Database service unavailable", 503)

    @app.post("/api/ai/generate-pretrip-checklist")
    def generate_pretrip():
        try:
            payload = validate_generation_request(require_object(request.get_json(silent=True)))
            duration = trip_duration_days(payload["start_date"], payload["end_date"])
            documents = db().list("documents", {"traveller_id": payload["traveller_id"]})
            requirements = db().list(
                "entry-requirements",
                {"destination_country": payload["destination"]},
            )
            prompt = (
                "Generate a personalised packing checklist and pre-trip tasks.\n"
                "Consider destination, trip length, dates, climate and planned activities.\n"
                "Return JSON only with keys packing_items and pre_trip_tasks.\n"
                "packing_items: [{item_name, category, quantity, reason}]\n"
                "pre_trip_tasks: [{task_name, description, priority, suggested_due_date, reason}]\n"
                "category must be one of Clothing, Toiletries, Electronics, Documents, "
                "Medication / Health, Activity Equipment, Miscellaneous.\n"
                "priority must be low, medium or high.\n"
                "Explain WHY each recommendation was made in the reason field.\n"
                "Do not invent immigration rules not present in the supplied entry requirements.\n"
                f"Context: {json.dumps({'trip': payload, 'duration_days': duration, 'documents': documents, 'entry_requirements': requirements})}"
            )
            ai_data = ollama().generate_json(prompt)
            packing_items = ai_data.get("packing_items")
            tasks = ai_data.get("pre_trip_tasks")
            if not isinstance(packing_items, list) or not isinstance(tasks, list):
                raise OllamaError("Malformed AI response", 502)
            suggestions = {
                "trip": payload,
                "duration_days": duration,
                "packing_items": packing_items,
                "pre_trip_tasks": tasks,
                "persisted": False,
                "review_required": True,
                "phase": "PLAN",
            }
            return json_ok(suggestions)
        except ValidationError as exc:
            return json_error(exc.message, exc.status)
        except OllamaError as exc:
            return json_error(exc.message, exc.status)
        except DatabaseUnavailable:
            return json_error("Database service unavailable", 503)

    @app.post("/api/ai/save-pretrip-checklist")
    def save_pretrip():
        try:
            payload = require_object(request.get_json(silent=True))
            trip = validate_generation_request(payload.get("trip") or payload)
            packing_items = payload.get("packing_items") or []
            tasks = payload.get("pre_trip_tasks") or []
            if not isinstance(packing_items, list) or not isinstance(tasks, list):
                raise ValidationError("packing_items and pre_trip_tasks must be lists")
            list_payload = validate_packing_list(
                {
                    **trip,
                    "planned_activities": trip["planned_activities"],
                    "generated_by_ai": True,
                }
            )
            status, body = db().create("packing-lists", list_payload)
            if status != 201 or not body or not body.get("success"):
                return forward(status, body)
            packing_list = body["data"]
            saved_items = []
            for item in packing_items:
                item_payload = validate_checklist_item(
                    {
                        "packing_list_id": packing_list["id"],
                        "item_name": item.get("item_name"),
                        "category": item.get("category"),
                        "quantity": item.get("quantity", 1),
                        "is_completed": False,
                        "is_ai_generated": True,
                    }
                )
                item_status, item_body = db().create("checklist-items", item_payload)
                if item_status == 201 and item_body and item_body.get("success"):
                    saved_items.append(item_body["data"])
            saved_tasks = []
            for task in tasks:
                due = task.get("suggested_due_date") or trip["start_date"]
                task_payload = validate_task(
                    {
                        "trip_id": trip["trip_id"],
                        "traveller_id": trip["traveller_id"],
                        "task_name": task.get("task_name"),
                        "description": task.get("description") or task.get("reason") or "AI-generated pre-trip task",
                        "due_date": due,
                        "priority": task.get("priority") or "medium",
                        "is_completed": False,
                        "is_ai_generated": True,
                    }
                )
                task_status, task_body = db().create("pre-trip-tasks", task_payload)
                if task_status == 201 and task_body and task_body.get("success"):
                    saved_tasks.append(task_body["data"])
            return json_ok(
                {
                    "packing_list": packing_list,
                    "checklist_items": saved_items,
                    "pre_trip_tasks": saved_tasks,
                    "phase": "ACT",
                },
                201,
            )
        except ValidationError as exc:
            return json_error(exc.message, exc.status)
        except DatabaseUnavailable:
            return json_error("Database service unavailable", 503)

    @app.get("/api/agentic/status")
    def agentic_status():
        trip_id = request.args.get("trip_id") or "trip-001"
        traveller_id = request.args.get("traveller_id") or "traveller-001"
        destination = request.args.get("destination") or "Japan"
        nationality = request.args.get("nationality") or "Australian"
        departure = request.args.get("departure_date") or "2026-09-01"
        return_date = request.args.get("return_date") or "2026-09-10"
        try:
            documents = db().list("documents", {"traveller_id": traveller_id})
            packing_lists = db().list("packing-lists", {"trip_id": trip_id})
            tasks = db().list("pre-trip-tasks", {"trip_id": trip_id})
            items: list[dict[str, Any]] = []
            for packing in packing_lists:
                items.extend(db().list("checklist-items", {"packing_list_id": packing["id"]}))
            _, _, result = load_compliance_context(
                {
                    "trip_id": trip_id,
                    "traveller_id": traveller_id,
                    "destination": destination,
                    "nationality": nationality,
                    "departure_date": departure,
                    "return_date": return_date,
                }
            )
        except DatabaseUnavailable:
            return json_error("Database service unavailable", 503)
        except ValidationError as exc:
            return json_error(exc.message, exc.status)

        incomplete_items = [item for item in items if not item.get("is_completed")]
        incomplete_tasks = [task for task in tasks if not task.get("is_completed")]
        adapt_actions = []
        if result["missing_documents"] or result["expired_documents"]:
            adapt_actions.append("Rerun compliance checking after updating documents.")
        if incomplete_items:
            adapt_actions.append("Complete remaining packing items or regenerate the checklist if trip details changed.")
        if incomplete_tasks:
            adapt_actions.append("Finish outstanding pre-trip tasks before departure.")
        if not adapt_actions:
            adapt_actions.append("No adaptation required. Continue monitoring expiry dates.")
        return json_ok(
            {
                "plan": {
                    "compliance_summary": result["summary"],
                    "recommended_actions": result["recommended_actions"],
                },
                "act": {
                    "incomplete_packing_items": len(incomplete_items),
                    "incomplete_tasks": len(incomplete_tasks),
                },
                "observe": {
                    "alerts": result["alerts"],
                    "packing_progress": {
                        "completed": len(items) - len(incomplete_items),
                        "total": len(items),
                    },
                    "task_progress": {
                        "completed": len(tasks) - len(incomplete_tasks),
                        "total": len(tasks),
                    },
                    "days_until_departure": (
                        datetime.strptime(departure, "%Y-%m-%d") - datetime.utcnow()
                    ).days,
                },
                "adapt": {"recommended_next_steps": adapt_actions},
            }
        )

    @app.errorhandler(404)
    def not_found(_exc):
        return json_error("Not found", 404)

    @app.errorhandler(500)
    def server_error(_exc):
        logger.exception("Unexpected server error")
        return json_error("Internal server error", 500)

    return app


app = create_app()


