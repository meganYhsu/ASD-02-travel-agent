from pathlib import Path

Path("docker-compose.yml").write_text(
    """networks:
  travel-net:
    driver: bridge

volumes:
  ollama_data:
  student5_data:

services:
  ollama:
    image: ollama/ollama:latest
    container_name: ollama
    ports:
      - "11434:11434"
    volumes:
      - ollama_data:/root/.ollama
    networks:
      - travel-net

  shared-frontend:
    image: nginx:1.27-alpine
    ports:
      - "8080:80"
    volumes:
      - ./shared/frontend/index.html:/usr/share/nginx/html/index.html:ro
      - ./shared/frontend/css:/usr/share/nginx/html/css:ro
      - ./shared/frontend/nginx.conf:/etc/nginx/conf.d/default.conf:ro
    networks:
      - travel-net

  student5-database:
    build:
      context: ./student-5/database
    environment:
      PORT: "5405"
      DATABASE_PATH: /data/travel_docs.db
    volumes:
      - student5_data:/data
    ports:
      - "5405:5405"
    networks:
      - travel-net

  student5-backend:
    build:
      context: ./student-5/backend
    environment:
      PORT: "5505"
      DATABASE_SERVICE_URL: http://student5-database:5405
      OLLAMA_BASE_URL: http://ollama:11434
      OLLAMA_MODEL: qwen2.5:3b
      OLLAMA_TIMEOUT_SECONDS: "60"
      EXPIRY_WARNING_DAYS: "90"
    ports:
      - "5505:5505"
    depends_on:
      - student5-database
      - ollama
    networks:
      - travel-net

  student5-frontend:
    build:
      context: ./student-5/frontend
    environment:
      PORT: "8505"
      BACKEND_URL: http://student5-backend:5505
    ports:
      - "8505:8505"
    depends_on:
      - student5-backend
    networks:
      - travel-net
""",
    encoding="utf-8",
)
print("wrote docker-compose.yml")
